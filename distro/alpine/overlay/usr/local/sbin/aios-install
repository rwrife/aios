#!/bin/sh
# Guided install. Destructive operations happen only after exact disk
# confirmation, and only if every guard still holds at that moment.
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run doas /usr/local/sbin/aios-install'; exit 1; }
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset APKOVL ERASE_DISKS ROOT SYSROOT BOOTLOADER_DISKS
# Disk guards, the stable disk identity, the offline repository switch and the
# post-setup-disk sequence live here so they can be tested without a disk.
# Sourced after PATH is reset.
. /usr/local/lib/aios/install.sh
echo 'AIOS installation — all data on the selected disk will be erased.'
lsblk -d -o NAME,SIZE,MODEL,TYPE
printf 'Full disk path (or Enter to cancel): '
read -r disk
[ -n "$disk" ] || exit 0
# Unsupported path, partition, live medium, active swap, mounted filesystem or
# mapped device: refuse before anything else happens.
aios_disk_guards "$disk" || exit 1
# The identity this confirmation applies to, captured before the operator is
# asked to type anything. Everything after the prompt is checked against it.
identity=$(aios_disk_identity "$disk") || {
    echo 'The selected disk does not report a stable identity.'; exit 1; }
# The ISO's own package repository, discovered from the kernel's mount table.
# Refused here rather than after the disk has been erased.
repository=$(aios_boot_repository) || {
    echo 'The booted medium carries no usable local package repository; an offline'
    echo 'installation cannot proceed.'; exit 1; }
lsblk -d -o PATH,SIZE,MODEL,SERIAL "$disk"
printf 'Type ERASE %s to permanently erase this disk: ' "$disk"
read -r confirmation
aios_confirmation_matches "$confirmation" "$disk" || { echo 'Cancelled'; exit 0; }
# Re-run every guard and re-read the identity immediately before partitioning.
aios_disk_unchanged "$disk" "$identity" || exit 1
firmware=$(aios_firmware_mode)
mountdir=$(mktemp -d /mnt/aios-install.XXXXXX)
saved_repositories=$(mktemp /tmp/aios-repositories.XXXXXX)
cleanup() {
    # The live repository configuration is restored on every exit path,
    # including a failed or interrupted setup-disk.
    aios_restore_repositories "$saved_repositories" || true
    rm -f "$saved_repositories"
    # A bind mount left inside the target would keep its root busy and make the
    # umount below fail, so the chroot filesystems come off first.
    aios_unmount_chroot_filesystems "$mountdir" || true
    mountpoint -q "$mountdir/boot/efi" && umount "$mountdir/boot/efi" || true
    mountpoint -q "$mountdir" && umount "$mountdir" || true
    rmdir "$mountdir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
parted -s "$disk" mklabel gpt
if [ "$firmware" = uefi ]; then
    parted -s "$disk" mkpart ESP fat32 1MiB 513MiB set 1 esp on
else
    parted -s "$disk" mkpart BIOS 1MiB 3MiB set 1 bios_grub on
fi
parted -s "$disk" mkpart root ext4 513MiB 100%
partprobe "$disk"
udevadm settle
prefix=$(aios_partition_prefix "$disk")
mkfs.ext4 -F "${prefix}2"
mount "${prefix}2" "$mountdir"
if [ "$firmware" = uefi ]; then
    mkfs.vfat -F 32 "${prefix}1"
    mkdir -p "$mountdir/boot/efi"
    mount "${prefix}1" "$mountdir/boot/efi"
fi
# setup-disk installs Alpine into an already mounted root and generates fstab,
# the target mkinitfs configuration and the appropriate GRUB bootloader. Its
# version comes from Alpine. It resolves packages through the live
# /etc/apk/repositories, which now names only the ISO's own repository, so the
# installation is served entirely from the medium.
#
# setup-disk leaves the GRUB configuration to the grub package's APK trigger.
# That trigger runs grub-probe against the *live* root and fails there; apk
# reports the trigger error but still completes, and setup-disk returns
# success. The configuration this system boots from is therefore generated
# explicitly, inside the target, once the packages are in place.
aios_use_local_repository "$repository" "$saved_repositories"
BOOTLOADER=grub setup-disk -m sys "$mountdir"
aios_restore_repositories "$saved_repositories"
if [ "$firmware" = uefi ]; then
    grub-install --target=x86_64-efi --efi-directory="$mountdir/boot/efi" \
        --boot-directory="$mountdir/boot" --removable --no-nvram
else
    grub-install --target=i386-pc --boot-directory="$mountdir/boot" "$disk"
fi
# Offline package parity, explicit regeneration and fail-closed readback.
# Success is reported only when this returns zero; cleanup unmounts either way.
aios_finalize_target "$mountdir" "$firmware" || exit 1
echo 'Installation complete. Shut down, remove the ISO/USB, then boot from disk.'
