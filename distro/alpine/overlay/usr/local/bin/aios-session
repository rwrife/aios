#!/bin/sh
set -eu

# Minimal visual baseline
xsetroot -solid '#0d1117'

mkdir -p "$HOME/.local/state/aios"
# ARandR saves a user-owned layout script here. A disconnected display must
# not prevent the desktop from starting.
if [ -f "$HOME/.screenlayout/default.sh" ]; then
    sh "$HOME/.screenlayout/default.sh" >>"$HOME/.local/state/aios/display.log" 2>&1 || true
else
    # Virtual displays often advertise 1280x800 as preferred despite supporting
    # Full HD. Keep physical displays at their native mode and honor saved layouts.
    xrandr --query 2>/dev/null | awk '
        /^[^ ]/ { output = ($1 ~ /^Virtual-/ && $2 == "connected") ? $1 : ""; large = 0
            for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+[+]/) {
                split($i, size, /[x+]/); large = size[1] >= 1920 && size[2] >= 1080
            }
        }
        output != "" && !large && $1 == "1920x1080" { print output }
    ' | while IFS= read -r output; do
        xrandr --output "$output" --mode 1920x1080 >>"$HOME/.local/state/aios/display.log" 2>&1 || true
    done
fi
openbox &
wm=$!
# Software GLX can cache a window's initial (black) pixmap indefinitely.
# Probe the actual renderer rather than assuming that a virtual GPU is accelerated.
graphics_log="$HOME/.local/state/aios/graphics.log"
backend=xrender
if LC_ALL=C timeout 5 glxinfo -B >"$graphics_log" 2>&1; then
    if grep -q 'OpenGL renderer string:' "$graphics_log" &&
       ! grep -Eiq 'Accelerated: no|OpenGL renderer string:.*(llvmpipe|softpipe|swrast|software rasterizer)' "$graphics_log"; then
        backend=glx
    fi
fi
printf 'AIOS compositor: %s (renderer diagnostics: %s)\n' "$backend" "$graphics_log" >>"$HOME/.local/state/aios/compositor.log"
if [ "$backend" = xrender ]; then
    picom --config /etc/xdg/picom.conf --backend xrender --no-vsync >>"$HOME/.local/state/aios/compositor.log" 2>&1 &
else
    picom --config /etc/xdg/picom.conf >>"$HOME/.local/state/aios/compositor.log" 2>&1 &
fi
compositor=$!
trap 'kill "$compositor" "$wm" 2>/dev/null || true' EXIT INT TERM
# Mesa provides a software OpenGL fallback in virtual machines. Keep Qt Quick on
# its RHI renderer because the software scenegraph cannot display video frames.
# GStreamer avoids the Qt FFmpeg startup crash on the live desktop while
# preserving PulseAudio playback and camera support.
export QT_MEDIA_BACKEND="${QT_MEDIA_BACKEND:-gstreamer}"
# Match multimedia to the software-rendered desktop: avoid probing unavailable
# GPU media drivers in a VM. Audio capture/playback still uses PulseAudio.
# A comma is Qt's explicit empty hardware-backend list (an empty value is not).
export QT_FFMPEG_DECODING_HW_DEVICE_TYPES="${QT_FFMPEG_DECODING_HW_DEVICE_TYPES:-,}"
export QT_FFMPEG_ENCODING_HW_DEVICE_TYPES="${QT_FFMPEG_ENCODING_HW_DEVICE_TYPES:-,}"
export QT_DISABLE_HW_TEXTURES_CONVERSION="${QT_DISABLE_HW_TEXTURES_CONVERSION:-1}"
pulseaudio --start --exit-idle-time=-1 >>"$HOME/.local/state/aios/audio.log" 2>&1 || true
aios-shell >>"$HOME/.local/state/aios/session.log" 2>&1 || {
  aios-terminal -title "AIOS Recovery" -e sh -c 'printf "Desktop failed. Logs: ~/.local/state/aios/session.log\n"; exec bash'
}
wait "$wm"
