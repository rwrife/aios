# /etc/inittab for AI OS live session
# local appliance session; recovery consoles require a configured password
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# terminal logins
tty1::respawn:/sbin/agetty --autologin aios --noclear tty1 linux
tty2::respawn:/sbin/agetty 38400 tty2 linux
tty3::respawn:/sbin/agetty 38400 tty3 linux
ttyS0::respawn:/sbin/agetty 115200 ttyS0 vt100

# reboot/shutdown handling
::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
