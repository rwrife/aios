<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc"
                xmlns:xi="http://www.w3.org/2001/XInclude">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <keyboard>
    <keybind key="W-Return"><action name="Execute"><command>xterm</command></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>

  <mouse>
    <!-- Disable root menu on right-click. -->
    <context name="Root">
      <mousebind button="Right" action="Press" />
    </context>
  </mouse>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>aios</name>
    </names>
  </desktops>

  <applications>
    <application title="AIOS Desktop">
      <position force="yes"><x>0</x><y>0</y></position>
      <decor>no</decor><layer>below</layer><skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
    <application title="AIOS Chat">
      <position force="yes"><x>center</x><y>center</y></position>
      <focus>yes</focus>
    </application>
    <application title="AIOS Power">
      <decor>no</decor><layer>above</layer><focus>yes</focus>
      <skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
  </applications>

  <menu>
    <file>/etc/xdg/openbox/menu.xml</file>
  </menu>
</openbox_config>
